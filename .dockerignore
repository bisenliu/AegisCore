# Docker 构建上下文
*

# deployments/docker/user-service.Dockerfile 所需的 workspace 文件。
# go.work 会校验全部已登记模块，因此每个模块至少要放行 go.mod。
!go.work
!go.work.sum
!platform/
!platform/**
!tools/
!tools/nacos-config-seed/
!tools/nacos-config-seed/**
!tools/openapi-convert/
!tools/openapi-convert/go.mod
!tools/service-scaffold/
!tools/service-scaffold/go.mod
!user-service/
!user-service/**

# 已允许目录内的本地和生成噪音
**/.git
**/.gitignore
**/.DS_Store
**/Thumbs.db
**/.env
**/.env.*
**/*.log
**/logs/
**/bin/
**/pkg/
**/dist/
**/build/
**/tmp/
**/node_modules/
**/.codegraph/
**/.codex/
**/.gemini/
**/.kilo/
**/.kiro/
**/.kilocode/
**/.agent/
**/coverage.out
**/*.test
